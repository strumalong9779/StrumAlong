 "verses": [
  {
   "name": "Verse 1",
   "a": "Yan-kee Doo-dle",
   "b": "went to town, a-",
   "c": "rid-ing on a",
   "d": "po-ny;",
   "e": "stuck a feath-er",
   "f": "in his cap and",
   "g": "called it mac-a-",
   "h": "ro-ni."
  },
  {
   "name": "Verse 2",
   "a": "Fath'r and I went",
   "b": "down to camp a-",
   "c": "long with Cap-tain",
   "d": "Good-in',",
   "e": "and there we saw the",
   "f": "men and boys as",
   "g": "thick as has-ty",
   "h": "pud-din'."
  },
  {
   "name": "Verse 3",
   "a": "And there was Cap-tain",
   "b": "Wash-ing-ton up-",
   "c": "on a slap-ping",
   "d": "stal-lion,",
   "e": "a-giv-ing or-ders",
   "f": "to his men, I",
   "g": "guess there was a",
   "h": "mil-lion."
  }
 ],
